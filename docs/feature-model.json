            {
              "id": "integrations.home-assistant.state",
              "name": "機器の状態取得",
              "type": "mandatory",
              "status": "planned",
              "description": "",
              "children": []
            }
          ]
        },
        {
          "id": "integrations.music",
          "name": "音楽（Spotify）",
          "type": "optional",
          "status": "planned",
          "description": "Phase 3。Home Assistant の media_player 越しに操る。直に Spotify を叩かない。",
          "children": []
        },
        {
          "id": "integrations.photos",
          "name": "写真（Immich）",
          "type": "optional",
          "status": "planned",
          "description": "Phase 5。Google フォトは photoslibrary.readonly の廃止と Picker API の制約で選択肢から外した。",
          "children": []
        }
